# ============================================================
# TAYEEBA HOUSING LTD. ERP v2.6
# Environment Variables Configuration
# INSTRUCTIONS:
# 1. Copy this file: cp .env.example server/.env
# 2. Fill in your actual values below
# 3. NEVER commit server/.env to Git
# 4. Only VITE_* variables are safe for frontend
# ============================================================

# ============================================================
# FRONTEND (Vite) — ONLY VITE_ prefixed vars reach the browser
# ============================================================
VITE_API_URL=http://localhost:5000/api

# ============================================================
# DATABASE — Supabase PostgreSQL
# Get from: Supabase Dashboard → Settings → Database → Connection string (URI mode)
# ============================================================
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ============================================================
# SECURITY — JWT Secrets
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ============================================================
JWT_SECRET=replace-with-256-bit-random-secret
JWT_REFRESH_SECRET=replace-with-different-256-bit-random-secret

# ============================================================
# SUPABASE STORAGE (for document uploads)
# Service Role Key — NEVER expose to frontend
# Get from: Supabase Dashboard → Settings → API → service_role key
# ============================================================
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxx

# Storage bucket names (create in Supabase Storage)
STORAGE_BUCKET_CUSTOMERS=customer-documents
STORAGE_BUCKET_PROJECTS=project-documents
STORAGE_BUCKET_LAND=land-documents
STORAGE_BUCKET_EMPLOYEES=employee-documents

# ============================================================
# EMAIL (for Forgot Password OTP)
# Use Gmail with App Password (enable 2FA first)
# Gmail: myaccount.google.com → Security → App Passwords
# ============================================================
EMAIL_USER=sbmreazul@gmail.com
EMAIL_PASS=your-16-character-gmail-app-password

# ============================================================
# SERVER CONFIGURATION
# ============================================================
PORT=5000
NODE_ENV=development

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://reazul94.github.io

# Security: max failed login attempts before lockout
MAX_FAILED_LOGINS=5
